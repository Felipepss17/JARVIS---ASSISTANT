# Copie para .env e preencha somente os serviços que for usar.
GROQ_API_KEY=

# Roblox Studio (opcional): pasta com os arquivos-fonte .lua/.luau do projeto
JARVIS_ROBLOX_PROJECT_DIR=

# Busca de arquivos (opcional): pastas separadas por ; no Windows
# Padrão: Documentos, Área de Trabalho e Downloads do usuário
JARVIS_FILE_SEARCH_DIRS=
